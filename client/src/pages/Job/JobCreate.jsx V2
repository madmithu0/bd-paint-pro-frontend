import { useState, useMemo } from 'react';
import { useNavigate } from 'react-router-dom';
import api from '../../utils/api';
import toast from 'react-hot-toast';

const PRICE_PER_SQFT = 12;
const MATERIAL_PER_SQFT = 18;
const PER_DAY_SQFT = 450;

const JobCreateV2 = () => {
  const navigate = useNavigate();
  const [loading, setLoading] = useState(false);
  const [step, setStep] = useState(1); // V2: Step Form 1-2-3
  const [form, setForm] = useState({
    title: '', address: '', phone: '', sqft: '',
    materialSource: 'company', hasAgent: 'no',
    agentName: '', agentPhone: '', description: '', slot: 'morning',
  });
  const [photos, setPhotos] = useState([]);
  const [wallProblems, setWallProblems] = useState({ nona: false, damp: false, fatol: false });

  const sqft = parseFloat(form.sqft) || 0;

  const calc = useMemo(() => {
    const mistriPrice = sqft * PRICE_PER_SQFT;
    const materialCost = form.materialSource === 'customer' ? 0 : sqft * MATERIAL_PER_SQFT;
    const total = mistriPrice + materialCost;
    const days = sqft / PER_DAY_SQFT;
    const mistriCount = sqft === 0 ? 0 : Math.max(1, Math.ceil(days));
    const perMistriShare = mistriCount ? (mistriPrice * 0.80) / mistriCount : 0;
    return { mistriPrice, materialCost, total, days, mistriCount, perMistriShare };
  }, [sqft, form.materialSource]);

  const handleChange = (e) => setForm({ ...form, [e.target.name]: e.target.value });

  const handleSubmit = async () => {
    if (!sqft) return toast.error('Sqft দিন');
    if (!form.address) return toast.error('Address দিন');
    const fd = new FormData();
    Object.entries(form).forEach(([k, v]) => fd.append(k, v));
    fd.append('sqft', sqft);
    fd.append('mistriPrice', calc.mistriPrice);
    fd.append('materialCost', calc.materialCost);
    fd.append('totalPrice', calc.total);
    fd.append('days', calc.days);
    fd.append('mistriCount', calc.mistriCount);
    fd.append('wallProblems', JSON.stringify(wallProblems));
    photos.forEach((f) => fd.append('photos', f));

    setLoading(true);
    try {
      const { data } = await api.post('/jobs', fd, { headers: { 'Content-Type': 'multipart/form-data' } });
      toast.success('Job Created V2!');
      navigate(`/jobs/${data?.job?._id || data?._id}`);
    } catch (err) {
      toast.error(err.response?.data?.message || 'Failed');
    } finally { setLoading(false); }
  };

  return (
    <div className="max-w-3xl mx-auto p-4">
      <h1 className="text-2xl font-bold">Job Create V2</h1>
      <p className="text-sm text-gray-500 mb-3">Step {step} / 3 - {step === 1 ? 'Job Info' : step === 2 ? 'Photo & Wall' : 'Price Confirm'}</p>

      {/* Progress */}
      <div className="flex gap-1 mb-4">
        {[1, 2, 3].map((s) => (
          <div key={s} className={`h-2 flex-1 rounded-full ${step >= s ? 'bg-blue-600' : 'bg-gray-200'}`} />
        ))}
      </div>

      <div className="bg-white rounded-xl shadow p-5 space-y-4">
        {/* STEP 1 */}
        {step === 1 && (
          <>
            <input name="title" value={form.title} onChange={handleChange} placeholder="Job Title" className="w-full border rounded-lg p-3" />
            <input name="address" value={form.address} onChange={handleChange} placeholder="Address *" className="w-full border rounded-lg p-3" />
            <input name="phone" value={form.phone} onChange={handleChange} placeholder="Phone *" className="w-full border rounded-lg p-3" />
            <div>
              <label className="font-bold">Sqft Input *</label>
              <input type="number" name="sqft" value={form.sqft} onChange={handleChange} placeholder="Ex: 100" className="w-full border rounded-lg p-3 mt-1 text-xl font-bold" />
              {/* 100 Sqft = 0.22 Day Show */}
              <div className="bg-yellow-50 rounded-lg p-3 mt-2 text-sm space-y-1">
                <p>📐 <b>{sqft || 0} Sqft</b> = <b>{calc.days.toFixed(2)} Day</b></p>
                <p className="text-gray-500">100 Sqft = 0.22 Day • 450 Sqft = 1 Day • 900 Sqft = 2 Day</p>
                <p>Mistri Count: <b>{calc.mistriCount} জন</b></p>
              </div>
            </div>
            <div>
              <label className="font-bold">Material Source</label>
              <div className="flex gap-2 mt-1">
                <button type="button" onClick={() => setForm({ ...form, materialSource: 'company' })} className={`flex-1 py-2 rounded-lg border ${form.materialSource === 'company' ? 'bg-blue-600 text-white' : ''}`}>Company</button>
                <button type="button" onClick={() => setForm({ ...form, materialSource: 'customer' })} className={`flex-1 py-2 rounded-lg border ${form.materialSource === 'customer' ? 'bg-green-600 text-white' : ''}`}>Customer</button>
              </div>
              {form.materialSource === 'customer' && <p className="text-green-600 text-sm font-bold mt-1">Material Cost Zero - Mistri Only Price</p>}
            </div>
            <button onClick={() => setStep(2)} className="w-full bg-blue-600 text-white py-3 rounded-lg font-bold">Next → Photo</button>
          </>
        )}

        {/* STEP 2 */}
        {step === 2 && (
          <>
            <div>
              <label className="font-bold">Photo Upload</label>
              <input type="file" multiple accept="image/*" onChange={(e) => setPhotos([...photos, ...Array.from(e.target.files)])} className="w-full border rounded-lg p-2 mt-1" />
              <div className="flex gap-2 mt-2 flex-wrap">{photos.map((f, i) => <img key={i} src={URL.createObjectURL(f)} className="w-20 h-20 object-cover rounded" alt="" />)}</div>
            </div>
            <div className="border rounded-xl p-3 bg-yellow-50">
              <label className="font-bold">Wall Problem</label>
              <div className="flex gap-3 mt-2">
                {['nona', 'damp', 'fatol'].map((k) => (
                  <label key={k} className="flex items-center gap-1 text-sm capitalize"><input type="checkbox" checked={wallProblems[k]} onChange={() => setWallProblems({ ...wallProblems, [k]: !wallProblems[k] })} /> {k === 'nona' ? 'নোনা' : k === 'damp' ? 'Damp' : 'ফাটল'}</label>
                ))}
              </div>
            </div>
            <div className="flex gap-2">
              <button onClick={() => setStep(1)} className="flex-1 bg-gray-100 py-3 rounded-lg">← Back</button>
              <button onClick={() => setStep(3)} className="flex-1 bg-blue-600 text-white py-3 rounded-lg font-bold">Next → Price</button>
            </div>
          </>
        )}

        {/* STEP 3 */}
        {step === 3 && (
          <>
            <div className="bg-blue-50 rounded-xl p-4 space-y-2 text-sm">
              <h3 className="font-bold text-base">💰 Price Auto Calculate</h3>
              <div className="flex justify-between"><span>Mistri Only Price</span><b>৳{calc.mistriPrice.toLocaleString()}</b></div>
              <div className="flex justify-between"><span>Material Cost {form.materialSource === 'customer' ? '(Zero)' : ''}</span><b>৳{calc.materialCost.toLocaleString()}</b></div>
              <div className="flex justify-between border-t pt-2"><span>Total</span><b className="text-xl text-blue-700">৳{calc.total.toLocaleString()}</b></div>
              <div className="flex justify-between"><span>Day (450 Sqft/Day)</span><b>{calc.days.toFixed(2)} Day</b></div>
              <div className="flex justify-between"><span>100 Sqft Show</span><b>0.22 Day</b></div>
              <div className="flex justify-between"><span>Per Mistri Share</span><b>৳{calc.perMistriShare.toFixed(0)}</b></div>
            </div>
            <div className="flex gap-2">
              <button onClick={() => setStep(2)} className="flex-1 bg-gray-100 py-3 rounded-lg">← Back</button>
              <button onClick={handleSubmit} disabled={loading} className="flex-1 bg-green-600 text-white py-3 rounded-lg font-bold disabled:opacity-50">{loading ? 'Creating...' : `Confirm - ৳${calc.total.toLocaleString()}`}</button>
            </div>
          </>
        )}
      </div>
    </div>
  );
};

export default JobCreateV2;